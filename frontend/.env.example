NEXT_PUBLIC_SUPABASE_URL="https://rgvovkaxfwzewpmtrguz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"

# Where a winner turns a prize into money. Read from its own stellar.toml, so
# this is the only thing about an anchor that is configured; pointing at a
# different one is a change of this line and nothing else.
NEXT_PUBLIC_ANCHOR_DOMAIN="tr-mock-anchor.fly.dev"

NEXT_PUBLIC_SEALER_URL="http://localhost:8787"

# The collection service's own address, which is frozen into every constitution
# this deployment locks: the contract asks that exact key to authorize the score
# root, so it has to be the public half of SEALER_SECRET_KEY in backend/.env.
#
# Leave it out only when running no service at all. The organizer is named as
# their own sealer then, and publishes the root by hand from the panel.
NEXT_PUBLIC_SEALER_ADDRESS="GDTQSU3L2UVUEFOHEGDO5FNICW2URPWNFEQVZYK46LX6ZPNCYDUNEVGC"

# Which OAuth providers this deployment offers, comma separated. Empty or
# absent means email codes only, which is the one way in that needs nothing
# registered anywhere.
#
# Naming a provider here only draws its button. Each one also needs an app
# registered with the provider and its client id and secret pasted into
# Supabase under Authentication -> Providers:
#
#   github   a GitHub OAuth App, free, two minutes, no cloud console
#   google   an OAuth client in Google Cloud Console, plus a consent screen
NEXT_PUBLIC_OAUTH_PROVIDERS=""

# Where the platform's cut is paid, and it has to be a Stellar address this
# deployment controls. A tier above community quotes a rate, the rate goes into
# the frozen constitution, and the contract pays this address at settlement.
#
# Leaving it empty is a working configuration: every event is created at a zero
# rate. What is refused is a rate above zero with nowhere to send it, which the
# create page blocks rather than quietly turning into a free event.
NEXT_PUBLIC_PLATFORM_FEE_COLLECTOR=""

# Who hears about a new organizer application, and the key that sends it.
#
# Both optional and both needed together. Without them applications still arrive
# and are still answered at /admin/organizers; nobody is told they are waiting.
# The default sender is Resend's shared address, which only delivers to the
# account that owns the Resend key, so nothing has to be verified to start.
RESEND_API_KEY=""
APPLICATIONS_EMAIL=""

# End-to-end journeys. Leave unset to skip them. Never put a funded mainnet secret here.
E2E_BASE_URL=
E2E_TEST_SECRET=

# The key this deployment signs builder credentials with.
#
# A credential is signed JSON somebody hands to a grant committee or an
# employer, so the signature has to come from a key this platform publishes —
# and the secret has to stay here. No NEXT_PUBLIC_ prefix on purpose: that is
# what keeps Next from inlining it into a client bundle, and `lib/credentials`
# throws outright if the keypair is ever loaded where `window` exists.
#
# Without it the export control says this deployment cannot issue credentials,
# which is the honest answer rather than an unsigned file.
STELHACKS_CREDENTIAL_SECRET=""

# The public half of the key above, so a browser can say which key it expects
# before anybody pastes a credential into the verification page.
#
# Safe to publish — it is a public key — and worth publishing: a signature that
# verifies against a key nobody recognises proves only that whoever made the
# credential also made the key.
NEXT_PUBLIC_STELHACKS_CREDENTIAL_KEY_ID=""
